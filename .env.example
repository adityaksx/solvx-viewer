# SolvX Environment Configuration
# ===============================

# ---------------------------------------------------------------------------
# Copernicus Marine Service
# ---------------------------------------------------------------------------
# Required for live Copernicus Marine downloads.
# Get these from your Copernicus Marine account.
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=

# Optional legacy/compatibility key. The current CopernicusAdapter uses the
# username/password variables above.
COPERNICUS_API_KEY=

# ---------------------------------------------------------------------------
# INCOIS
# ---------------------------------------------------------------------------
INCOIS_BASE_URL=https://erddap.incois.gov.in/erddap
INCOIS_API_KEY=
INCOIS_USERNAME=
INCOIS_PASSWORD=

# ---------------------------------------------------------------------------
# NOAA / map services
# ---------------------------------------------------------------------------
NOAA_ERDDAP_URL=https://coastwatch.pfeg.noaa.gov/erddap/griddap
MAPTILER_API_KEY=

# ---------------------------------------------------------------------------
# Application behaviour
# ---------------------------------------------------------------------------
SOLVX_LOCAL_DATA_MODE=false
LOCAL_DATA_MODE=false
MOCK_DATA=false
REQUEST_TIMEOUT=12
CACHE_MAX_SIZE=256
CACHE_TTL=3600
MAX_REQUEST_AREA_DEG2=1500.0

# ---------------------------------------------------------------------------
# NVIDIA NIM LLM API (Server-Side Only - Never expose to client)
# ---------------------------------------------------------------------------
NVIDIA_API_KEY=
NVIDIA_PRIMARY_MODEL=deepseek-ai/deepseek-v4.1-flash
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ---------------------------------------------------------------------------
# Gemini AI
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
