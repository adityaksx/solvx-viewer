# SolvX Environmental Configuration
# Copy this file to .env and configure as needed.

# Map & Basemap Providers
# If MAPTILER_API_KEY is provided, MapLibre GL JS loads high-resolution MapTiler ocean/satellite tiles.
# If omitted or left empty, SolvX automatically falls back to OpenStreetMap raster tiles.
MAPTILER_API_KEY=

# INCOIS (Indian National Centre for Ocean Information Services)
# Base URLs for live scientific data access (ERDDAP & THREDDS)
INCOIS_BASE_URL=https://erddap.incois.gov.in/erddap
INCOIS_THREDDS_URL=https://las.incois.gov.in/thredds
INCOIS_API_KEY=

# Operational Mode
# When true, skips live network queries to INCOIS and uses verified local NetCDF model archives.
# Default: true (ensures high availability and offline operational capability)
SOLVX_LOCAL_DATA_MODE=true

# Server Configuration
SOLVX_API_HOST=127.0.0.1
SOLVX_API_PORT=8000
SOLVX_FRONTEND_PORT=5500
